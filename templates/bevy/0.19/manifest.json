{
  "name": "bevy-0.19",
  "stack": "bevy",
  "frameworkVersion": "0.19",
  "language": "rust",
  "buildTargets": ["native", "web"],
  "questions": [
    {
      "id": "window_title",
      "label": "Window title",
      "default": "{{project_name}}"
    },
    {
      "id": "crate_name",
      "label": "Crate name",
      "default": "{{project_name_snake}}"
    },
    {
      "id": "build_target",
      "label": "Build target",
      "default": "native"
    }
  ],
  "variables": {
    "project_name_snake": "{{project_name}} -> snake_case"
  },
  "commands": {
    "run": "./scripts/run.sh",
    "test": "./scripts/test.sh",
    "verifyCheck": ["cargo", "--version"],
    "verifyBuild": ["cargo", "check"]
  },
  "gettingStarted": "getting-started.md",
  "references": [
    "https://bevy.org/learn/quick-start/getting-started/setup/",
    "https://bevy.org/learn/quick-start/getting-started/setup/#linux",
    "https://bevy.org/learn/",
    "https://trunkrs.dev/"
  ]
}
